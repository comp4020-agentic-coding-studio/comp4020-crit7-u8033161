---
import { courseStats, listCourses, TEACHING_WEEKS } from "../lib/db";
import "../styles.css";

const courses = listCourses().map((course) => ({
  course,
  stats: courseStats(course.id),
  estimatedHoursPerWeek: course.officialWorkloadHours
    ? course.officialWorkloadHours / TEACHING_WEEKS
    : null,
}));
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Course Readiness Reference</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Courses</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>Course Readiness Reference</h1>
      <p>
        Programs & Courses gives you learning outcomes, assessment weights, and one blunt total
        workload figure. It doesn't tell you how hard a course actually feels, or how many hours a
        week it takes in practice. This page adds that: real feedback from students who've taken
        these courses, sitting next to the official numbers.
      </p>
      <p class="notice">
        This site is public and collects nicknames only — no names, student IDs, or emails. Please
        don't name or identify individual staff in your feedback.
      </p>
      <table>
        <thead>
          <tr>
            <th>Course</th>
            <th>Semester</th>
            <th>Official workload</th>
            <th>Student difficulty</th>
            <th>Student hours/week</th>
          </tr>
        </thead>
        <tbody>
          {
            courses.map(({ course, stats, estimatedHoursPerWeek }) => (
              <tr>
                <td>
                  <a href={`/courses/${course.code}/`}>
                    {course.code} — {course.title}
                  </a>
                </td>
                <td>{course.semester}</td>
                <td>
                  {course.officialWorkloadHours
                    ? `${course.officialWorkloadHours}h total (~${estimatedHoursPerWeek?.toFixed(1)}h/wk est.)`
                    : "not stated"}
                </td>
                <td>
                  {stats.avgDifficulty ? `${stats.avgDifficulty.toFixed(1)} / 5` : "no reports yet"}
                </td>
                <td>
                  {stats.avgHoursPerWeek ? `${stats.avgHoursPerWeek.toFixed(1)}h/wk` : "no reports yet"}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </main>
  </body>
</html>
